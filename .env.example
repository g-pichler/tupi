# Copy to .env and fill in the API key(s) for the provider(s) you use.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# Key for the `aqueduct` provider in pi-config/agent/models.json (default
# provider). Only needed if you keep aqueduct as your pi default; leave blank
# otherwise. models.json references it as ${AQUEDUCT_API_KEY}.
# AQUEDUCT_API_KEY=sk-...

# Rust toolchain installed when a rust.d unit lists crates (see rust.d.available/).
# Accepts anything rustup does: stable, beta, nightly, 1.83.0, nightly-2025-01-15.
# Changing it rebuilds the rust layer only.
# RUST_VERSION=stable
